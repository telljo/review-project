<div class="navbar_dropdown" data-controller="dropdown">
  <button type="button"
          class="navbar_dropdown__toggle"
          data-action="click->dropdown#toggle click@window->dropdown#hide"
          data-dropdown-target="button"
          aria-controls="navbar_dropdown_menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu">
    <span class="navbar_dropdown__icon" aria-hidden="true"></span>
  </button>

  <div id="navbar_dropdown_menu"
       data-dropdown-target="menu"
       class="navbar_dropdown__menu"
       role="menu"
       aria-orientation="vertical"
       tabindex="-1">
    <div class="navbar_dropdown__section">
      <a data-action="click->dropdown#close" class="navbar_dropdown__link" href="/">Home</a>
      <%= link_to "All books", books_path, data: { action: "click->dropdown#close" },
          class: "navbar_dropdown__link" %>
      <%= link_to "All reviews", reviews_path, data: { action: "click->dropdown#close" },
          class: "navbar_dropdown__link" %>
    </div>
    <% if user_signed_in? %>
      <div class="navbar_dropdown__section">
        <a data-action="click->dropdown#close" class="navbar_dropdown__link"
          href="<%= url_for(controller: '/books', action: 'index', username: current_user.username)%>">Your Books</a>
        <a data-action="click->dropdown#close" class="navbar_dropdown__link"
          href="<%= url_for(controller: '/reviews', action: 'index', username: current_user.username)%>">Your Reviews</a>
      </div>
    <% else %>
      <div class="navbar_dropdown__section">
        <%= link_to "Log In",
          new_user_session_path,
          data: { action: "click->dropdown#close" },
          class:"navbar_dropdown__link" %>
        <%= link_to "Sign Up",
          new_user_registration_path,
          data: { action: "click->dropdown#close" },
          class:"navbar_dropdown__link" %>
      </div>
    <% end %>
    <% if user_signed_in? %>
      <div class="navbar_dropdown__section">
        <a data-action="click->dropdown#close" class="navbar_dropdown__link"
          href="<%= url_for(controller: '/users', action: 'show', username: current_user.username)%>">Profile</a>
        <a data-action="click->dropdown#close" class="navbar_dropdown__link" href="/users/edit">Settings</a>
        <a data-action="click->dropdown#close" data-turbo-method="delete" class="navbar_dropdown__link" href="/users/sign_out">Sign Out</a>
      </div>
    <% end %>
  </div>
</div>
