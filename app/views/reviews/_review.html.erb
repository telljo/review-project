<%= turbo_frame_tag review do %>
  <article class="review">
    <div class="review__image">
      <% if review.book.image_link %>
        <%= image_tag review.book.image_link, class: "books__cover_image", alt: '' %>
      <% else %>
        <%= image_tag "no_cover.gif", class: "books__cover_image", alt: '' %>
      <% end %>
    </div>

    <div class="review__content">
      <div class="review__header">
        <div class="review__titles">
          <p class="review__eyebrow">
            <%= link_to review.user.username,
                user_path(username: review.user.username),
                class: "review__user_link",
                data: { turbo_frame: "_top"} %>
          </p>
          <h3 class="review__title">
            <%= link_to review.book.title,
                review_path(review),
                data: { turbo_frame: "_top" } %>
          </h3>
          <p class="review__author"><%= review.book.author %></p>
        </div>

        <p class="review__created_at"><%= review.created_at.strftime("%B %d, %Y") %></p>
      </div>

      <%= render 'reviews/rating', rating: review.rating %>

      <div class="review__body trix-content">
        <%= review.content %>
      </div>

      <% if current_user == review.user %>
        <div class="review__actions">
          <%= button_to "Delete",
                        review_path(review),
                        method: :delete,
                        class: "btn btn--danger btn--medium" %>

          <%= link_to "Edit review",
              edit_review_path(review),
              class: "btn btn--primary btn--medium" %>
        </div>
      <% end %>
    </div>
  </article>
<% end %>
