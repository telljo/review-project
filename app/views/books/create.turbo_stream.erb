<% if @search_result_footer_id.present? %>
  <%= turbo_stream.replace @search_result_footer_id do %>
    <%= render "google_books/result_actions", book: @book %>
  <% end %>
<% end %>

<% if params[:source] == "book_show" %>
  <%= turbo_stream.replace book_collection_actions_dom_id(@book) do %>
    <%= render "books/collection_actions", book: @book %>
  <% end %>
<% end %>

<%= render_turbo_stream_flash_messages %>
