<%# app/views/books/index.html.erb %>
<% if @user.present? %>
  <%= render "layouts/profile_section" %>
<% end %>

<div class="container container--no_style books__page">
  <div class="review_titles">
    <h1><%= @user.present? ? "Books" : "All Books" %></h1>
  </div>

  <% if @user.present? %>
    <div class="books__toolbar">
      <div class="review_titles">
        <%= render "books/bookshelf_dropdown", user: @user, selected_slug: @slug %>
      </div>
    </div>
  <% end %>

  <div class="books__sections">
    <% if @user.present? %>
      <% if @slug.present? %>
        <%= render "books/shelf_section",
            title: selected_bookshelf_label(@slug),
            path: books_index_path_for(user: @user, slug: @slug),
            books: @books,
            empty_title: "There are no books yet",
            empty_subtitle: "Be the first to add a book you've read." %>
      <% else %>
        <% user_bookshelf_sections(
            user: @user,
            read_books: @read_books,
            books_in_progress: @books_in_progress,
            to_read_books: @to_read_books
          ).each do |section| %>
          <%= render "books/shelf_section", **section %>
        <% end %>
      <% end %>
    <% else %>
      <%= render "books/shelf_section",
          title: nil,
          path: nil,
          books: @books,
          empty_title: "There are no books yet",
          empty_subtitle: "Be the first to add a book you've read." %>
    <% end %>
  </div>
</div>
