<div class="container container--wide container--no_style books__page" style="--bookshelf-plank-image: url('<%= asset_path("bookshelf-shelf.webp") %>');">
  <% collection_owner = @user&.username.presence || "The library" %>
  <% page_title = if @user.present?
                    @slug.present? ? selected_bookshelf_label(@slug) : "Bookshelf"
                  else
                    "Library"
                  end %>
  <% page_subtitle = if @owner_view && @slug.blank?
                       "Arrange your books across the shelves and drag them between sections whenever the stack changes."
                     elsif @user.present?
                       "A curated reading record with space for finished books, active reads, and the next volume waiting in line."
                     else
                       "Browse the shared collection and open any title to explore the notes around it."
                     end %>

  <section class="books__hero">
    <div class="books__hero_copy">
      <p class="books__eyebrow"><%= collection_owner %></p>
      <h1 class="books__page_title"><%= page_title %></h1>
      <p class="books__page_subtitle"><%= page_subtitle %></p>
    </div>

    <% if @user.present? %>
      <div class="books__hero_meta" aria-label="Collection summary">
        <div class="books__stat">
          <span class="books__stat_value"><%= @user.books.count %></span>
          <span class="books__stat_label">Books</span>
        </div>

        <div class="books__stat">
          <span class="books__stat_value"><%= @user.reviews.count %></span>
          <span class="books__stat_label">Reviews</span>
        </div>
      </div>
    <% end %>
  </section>

  <% if @user.present? %>
    <nav class="books__filters" aria-label="Bookshelf filters">
      <% bookshelves_menu_options(user: @user).each do |option| %>
        <% is_active = option[:slug].blank? ? @slug.blank? : option[:slug] == @slug %>
        <%= link_to option[:label],
            option[:path],
            class: class_names("books__filter", "books__filter--active": is_active) %>
      <% end %>
    </nav>
  <% end %>

  <div class="books__sections">
    <% if @user.present? %>
      <% if @slug.present? %>
        <%= render "books/shelf_section",
            title: selected_bookshelf_label(@slug),
            path: books_index_path_for(user: @user, slug: @slug),
            shelf_slug: @slug,
            books: @books,
            owner_view: @owner_view,
            empty_title: "There are no books yet",
            empty_subtitle: "Be the first to add a book you've read." %>
      <% else %>
        <% user_bookshelf_sections(
            user: @user,
            read_books: @read_books,
            books_in_progress: @books_in_progress,
            to_read_books: @to_read_books
          ).each do |section| %>
          <%= render "books/shelf_section", **section, owner_view: @owner_view %>
        <% end %>
      <% end %>
    <% else %>
      <%= render "books/shelf_section",
          title: nil,
          path: nil,
          shelf_slug: nil,
          books: @books,
          owner_view: false,
          empty_title: "There are no books yet",
          empty_subtitle: "Be the first to add a book you've read." %>
    <% end %>
  </div>
</div>
