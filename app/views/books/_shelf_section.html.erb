<% sortable_options = local_assigns[:sortable] %>
<% owner_view = local_assigns.fetch(:owner_view, false) %>
<section class="<%= class_names('books__section', 'books__section--untitled': title.blank?) %>">
  <% if title.present? %>
    <header class="books__section_header">
      <h2 class="books__section_title">
        <% if path.present? %>
          <%= link_to title, path, class: "books__section_title_link" %>
        <% else %>
          <%= title %>
        <% end %>
      </h2>

      <% if owner_view && local_assigns[:shelf_slug].present? %>
        <p class="books__section_hint">
          <%= if sortable_options.present?
                "Drag or use the buttons to reorder or move between shelves."
              else
                "Use the quick buttons on a book to move it to another shelf."
              end %>
        </p>
      <% end %>
    </header>
  <% end %>

  <div class="<%= class_names('books__outer_grid_layout', 'books__outer_grid_layout--empty': books.blank?) %>">
    <div class="books__shelf_shadow" aria-hidden="true"></div>

    <% if books.present? || sortable_options.present? %>
      <div class="<%= class_names('books__grid_layout', 'books__grid_layout--empty': books.blank?) %>"
        <% if sortable_options.present? %>
          id="<%= sortable_options[:id] %>"
          data-controller="bookshelf <%= sortable_options.dig(:data, :controller) %>"
          data-sortable-url="<%= sortable_options.dig(:data, :sortable_url) %>"
          data-sortable-source-id="<%= sortable_options.dig(:data, :sortable_source_id) %>"
        <% else %>
          data-controller="bookshelf"
        <% end %>>
        <% if books.present? %>
          <%= render books,
              owner_view:,
              shelf_slug: local_assigns[:shelf_slug],
              view_slug: local_assigns[:view_slug],
              show_actions: owner_view && local_assigns[:shelf_slug].present? %>
        <% end %>

        <% if sortable_options.present? %>
          <div class="books__empty_placeholder" aria-hidden="<%= books.present? %>">
            <%= render "books/empty_state",
                title: "Drop a book here",
                subtitle: "This shelf is empty right now. Drag a book into it or search for a new one to get started." %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "books/empty_state", title: empty_title, subtitle: empty_subtitle %>
    <% end %>

    <div class="books__shelf_plank" aria-hidden="true"></div>
  </div>
</section>
