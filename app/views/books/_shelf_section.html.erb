<% sortable_options = local_assigns[:sortable] %>
<% owner_view = local_assigns.fetch(:owner_view, false) %>
<% visitor_shelf = @user.present? && !owner_view %>
<% if visitor_shelf %>
  <% empty_title = 'No books on this shelf yet' %>
  <% empty_subtitle = "#{@user.username} hasn’t added any books to this shelf." %>
<% end %>
<% shelf_slug = local_assigns[:shelf_slug] %>
<% pagy = local_assigns[:pagy] %>
<% total_count = pagy&.count || books.size %>
<% subtitle = local_assigns[:subtitle] %>
<section id="<%= bookshelf_section_dom_id(shelf_slug) %>" class="<%= class_names('books__section', 'books__section--untitled': title.blank?) %>">
  <% if title.present? %>
    <header class="books__section_header">
      <h2 class="books__section_title">
        <% if path.present? %>
          <%= link_to title, path, class: "books__section_title_link" %>
        <% else %>
          <%= title %>
        <% end %>
      </h2>

      <div class="books__section_meta">
        <p class="books__section_count"><%= pluralize(total_count, "book") %></p>

        <% if subtitle.present? %>
          <p class="books__section_subtitle"><%= subtitle %></p>
        <% end %>
      </div>

      <% if pagy && pagy.last > 1 %>
        <div class="books__pagination books__pagination--section">
          <%== pagy.series_nav(aria_label: "#{title.presence || 'Books'} pages", **pagy_turbo_stream_options(shelf_slug)) %>
        </div>
      <% end %>
    </header>
  <% end %>

  <div class="<%= class_names('books__outer_grid_layout', 'books__outer_grid_layout--empty': books.blank?, 'books__outer_grid_layout--wooden': @user.present?) %>">
    <% if @user.present? %>
      <div class="books__cabinet_trim" aria-hidden="true"></div>
      <div class="books__cabinet_crown" aria-hidden="true">
        <span class="books__cabinet_crown_art"></span>
      </div>
    <% end %>
    <div class="books__shelf_shadow" aria-hidden="true"></div>

    <div class="<%= class_names('books__grid_layout', 'books__grid_layout--empty': books.blank?) %>"
      <% if sortable_options.present? %>
        id="<%= sortable_options[:id] %>"
        data-controller="bookshelf<%= " #{sortable_options.dig(:data, :controller)}" if owner_view %>"
        <% if owner_view %>
        data-sortable-url="<%= sortable_options.dig(:data, :sortable_url) %>"
        data-sortable-source-id="<%= sortable_options.dig(:data, :sortable_source_id) %>"
        <% end %>
      <% else %>
        data-controller="bookshelf"
      <% end %>>
      <% if books.present? %>
        <%= render books,
            owner_view:,
            shelf_slug: local_assigns[:shelf_slug],
            view_slug: local_assigns[:view_slug],
            show_actions: owner_view && local_assigns[:shelf_slug].present? %>
      <% end %>

      <% if (owner_view && sortable_options.present?) || books.blank? %>
        <div class="books__empty_placeholder" aria-hidden="<%= books.present? %>">
          <% if owner_view && sortable_options.present? %>
            <%= render "books/empty_state",
                title: "Drop a book here",
                subtitle: "This shelf is empty right now. Drag a book into it or search for a new one to get started." %>
          <% else %>
            <%= render "books/empty_state", title: empty_title, subtitle: empty_subtitle, show_search: !visitor_shelf %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="books__shelf_plank" aria-hidden="true"></div>
  </div>

  <% if title.blank? && pagy && pagy.last > 1 %>
    <div class="books__pagination">
      <p class="books__pagination_meta"><%= pluralize(total_count, "book") %> in the library</p>
      <%== pagy.series_nav(aria_label: "Books pages", **pagy_turbo_stream_options(shelf_slug)) %>
    </div>
  <% end %>
</section>
