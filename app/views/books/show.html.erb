<%# app/views/books/show.html.erb %>
<% review_count = book.reviews.count %>
<div class="container container--wide">
  <article class="book">
    <div class="book__aside">
      <div class="book__cover">
      <% if book.image_link %>
        <%= image_tag book.image_link, class: "book__cover-image" %>
      <% else %>
        <%= image_tag "no_cover.gif", class: "book__cover-image" %>
      <% end %>
      </div>
    </div>
    <div class="book__content">
      <header class="book__header">
        <div class="book__titles">
          <h1 class="book__title"><%= book.title %></h1>
          <h4 class="book__author"><%= book.author %></h4>
        </div>
        <div class="book__meta">
          <div class="book__rating">
            <% if book.average_review_score %>
              <div class="book__rating_summary">
                <p class="book__rating_value">
                  <strong class="book__rating-score"><%= book.average_review_score %></strong>
                </p>
              </div>
            <% end %>
            <div class="book__rating_stars form__show_rating_stars" aria-label="Average rating">
              <% [1,2,3,4,5].each do |i| %>
                <% if book.average_review_score && book.average_review_score >= i%>
                  <%= icon('fa-regular fas selected', 'star')%>
                <% else %>
                  <%= icon('fa-regular fas', 'star')%>
                <% end%>
              <% end %>
            </div>
          </div>
          <% if review_count.positive? %>
            <%= link_to pluralize(review_count, "review"),
                book_reviews_path(book),
                class: "book__reviews-link underline",
                data: { turbo_frame: "_top"} %>
          <% end %>
        </div>
      </header>
      <div class="book__body">
        <div class="trix-content">
          <p><%= book.description %></p>
        </div>
      </div>

      <%= render "books/collection_actions", book: book %>
    </div>
  </article>
</div>
