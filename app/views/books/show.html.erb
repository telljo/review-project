<%# app/views/books/show.html.erb %>
<div class="container container--wide">
  <article class="book">
    <div class="book__aside">
      <div class="book__cover">
      <% if book.image_link %>
        <%= image_tag book.image_link, class: "book__cover-image" %>
      <% else %>
        <%= image_tag "no_cover.gif", class: "book__cover-image" %>
      <% end %>
      </div>
    </div>
    <div class="book__content">
      <header class="book__header">
        <div class="book__titles">
          <h1 class="book__title"><%= book.title %></h1>
          <h4 class="book__author"><%= book.author %></h4>
        </div>
        <div class="book__meta">
          <div class="book__rating">
          <div class="book__rating_average">
            <% if book.average_review_score %>
              <p><strong class="book__rating-score"><%= book.average_review_score %></strong></p>
            <% end %>
            <div class="form__show_rating_stars">
              <% [1,2,3,4,5].each do |i| %>
                <% if book.average_review_score && book.average_review_score >= i%>
                  <%= icon('fa-regular fas selected', 'star')%>
                <% else %>
                  <%= icon('fa-regular fas', 'star')%>
                <% end%>
              <% end %>
            </div>
          </div>
          <% if book.reviews.count.positive? %>
            <%= link_to "#{book.reviews.count} reviews", "/books/#{book.id}/reviews", class: "book__reviews-link underline", data: { turbo_frame: "_top"} %>
          <% end %>
        </div>
        </div>
      </header>
      <div class="book__body">
        <div class="trix-content">
          <p><%= book.description %></p>
        </div>
      </div>

      <% if current_user %>
        <div class="form__buttons form__buttons--right">
          <% if current_user.books.find_by_isbn(book.isbn) && book.id %>
            <%= link_to "Write review",
                      new_review_path(book_id: book.id),
                      data: { turbo_frame: dom_id(Review.new) },
                      class: "btn btn--primary btn--medium" %>
            <%= button_to "Remove from collection",
                          book_path(book),
                          method: :delete,
                          class: "btn btn--danger btn--medium" %>
          <% else %>
            <%= render(:partial => 'books/add_to_collection',  locals: {
                    book: book
                    })
                  %>
          <% end %>
        </div>
      <% end %>
    </div>
  </article>
</div>
