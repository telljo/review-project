<% user_book = current_user&.user_books&.find_by(book_id: book.id) %>
<div id="<%= book_collection_actions_dom_id(book) %>" class="book__collection">
  <section id="save-to-shelf" aria-label="Your bookshelf">
    <% if current_user.blank? %>
      <%= button_to 'Save to shelf', book_selection_path, params: { book_id: book.id },
          class: 'btn btn--primary', form: { data: { turbo: false } } %>
      <p class="book__save_hint">Create an account or log in to choose a shelf.</p>
    <% elsif user_book %>
      <p class="book__saved" role="status">Saved to <strong><%= UserBook::SLUGS_READABLE.fetch(user_book.slug) %></strong></p>
      <%= link_to 'View my shelf', user_books_path(username: current_user.username, slug: user_book.slug), class: 'book__shelf_link' %>
      <details class="book__shelf_editor" <%= 'open' if @shelf_error.present? %>>
        <summary>Change shelf</summary>
        <%= render 'books/shelf_form', book: book, user_book: user_book %>
      </details>
      <div class="book__secondary_actions">
        <%= link_to 'Write review', new_review_path(book_id: book.id),
            data: { turbo_frame: '_top' }, class: 'btn btn--light' %>
        <%= button_to 'Remove from collection', book_path(book), method: :delete,
            params: { source: 'book_show' }, class: 'book__remove' %>
      </div>
    <% else %>
      <%= render 'books/shelf_form', book: book, user_book: nil %>
    <% end %>
  </section>
</div>
