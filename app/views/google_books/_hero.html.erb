<div class="container container--wide container--no_style">
  <section class="header__home-page">
    <div class="header__home-copy">
      <p class="header__eyebrow">Bookshelf</p>
      <h1 class="header__home-title">Your virtual bookshelf</h1>
      <p class="header__home-subtitle">Collect, review, and discover new books. Build a reading record that feels curated, personal, and easy to return to whenever your stack changes.</p>
    </div>

    <div class="header__home-meta" aria-label="Library overview">
      <a href="<%= books_path %>" class="header__stat">
        <span class="header__stat-value"><%= @books_count %></span>
        <span class="header__stat-label">Books tracked</span>
      </a>
      <a href="<%= reviews_path %>" class="header__stat">
        <span class="header__stat-value"><%= @reviews_count %></span>
        <span class="header__stat-label">Reviews written</span>
      </a>
    </div>
  </section>
</div>
