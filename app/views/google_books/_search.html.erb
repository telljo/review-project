<% home_variant = local_assigns.fetch(:home_variant, false) %>

<div
  class="<%= class_names('search', 'search--home': home_variant, 'search--ready': @query.present?) %>"
  data-controller="search"
  data-search-clear-url-value="<%= root_path %>"
>

  <div class="search__bar">
    <span class="search__icon" aria-hidden="true">
      <i class="fas fa-search"></i>
    </span>

    <%= form_with url: search_google_books_path,
      method: :get,
      scope: nil,
      id: "google-books-search-form",
      class: "search__form",
      data: {
        search_target: "form",
        turbo_frame: "book-list",
        turbo_action: "advance",
        action: "submit->search#submit"
      } do |form| %>
      <div class="search__controls">
        <%= form.label :scope, 'Search by', class: 'visually-hidden' %>
        <%= form.select :scope,
          GoogleBooksController::SEARCH_SCOPES.map { |value, label|
            [label, value, { 'data-placeholder' => GoogleBooksController::SEARCH_HINTS.fetch(value).first,
                            'data-hint' => GoogleBooksController::SEARCH_HINTS.fetch(value).last }]
          },
          { selected: @search_scope || "title" },
          {
            class: "search__scope",
            data: {
              action: "change->search#formChanged",
              search_target: "scopeSelect"
            }
          } %>

        <div class="search__input-wrap">
          <%= form.label :query, 'Search books', class: 'visually-hidden' %>
          <%= form.text_field :query,
            placeholder: GoogleBooksController::SEARCH_HINTS.fetch(@search_scope || 'title').first,
            class: "search__bar-input",
            value: @query,
            required: true,
            maxlength: GoogleBooksController::QUERY_LIMIT,
            dir: 'auto',
            enterkeyhint: 'search',
            aria: { describedby: 'search-hint search-feedback', invalid: (@query_error.present? ? 'true' : nil) },
            autocomplete: "off",
            data: {
              action: "input->search#formChanged",
              search_target: "searchInput"
            }
          %>

          <button
            type="button"
            class="search__clear"
            hidden
            aria-label="Clear search"
            data-action="click->search#clear"
            data-search-target="clearButton"
          >
            Clear
          </button>
        </div>
      </div>
    <% end %>

    <button
      type="submit"
      form="google-books-search-form"
      class="search__submit"
      aria-live="polite"
      aria-atomic="true"
      data-search-target="submitButton"
    >
      <span class="search__status-icon" data-search-target="search" aria-hidden="true">
        <i class="fas fa-search"></i>
      </span>
      <span
        class="search__status-icon visually-hidden"
        aria-hidden="true"
        data-search-target="spinner"
      >
        <i class="fas fa-spinner fa-spin"></i>
      </span>
      <span class="search__status-text" data-search-target="submitText">Search</span>
    </button>

  </div>
  <p id="search-hint" class="search__hint" data-search-target="hint"><%= GoogleBooksController::SEARCH_HINTS.fetch(@search_scope || 'title').last %></p>
  <p id="search-feedback" class="search__feedback" role="alert" data-search-target="feedback" <%= 'hidden' if @query_error.blank? %>><%= @query_error %></p>
  <button type="submit" form="google-books-search-form" class="btn btn--light search__retry" hidden data-search-target="retryButton">Retry search</button>
  <noscript><%= link_to 'Clear search', root_path, class: 'search__hint' %></noscript>
</div>
