<% loading = local_assigns.fetch(:loading, false) %>
<% frame_src = local_assigns[:frame_src] %>
<% results_count = @search_results.length %>

<%= turbo_frame_tag "book-list",
  class: class_names("search-results", "search-results--loading": loading),
  src: frame_src,
  aria: { busy: loading ? "true" : "false" } do %>
  <% if loading %>
    <%= render "loading_list" %>
  <% elsif @query.blank? %>
    <div class="search-results__empty">
      <% if @recently_added_books&.any? %>
        <%= render partial: 'books/recently_added' %>
      <% end %>
    </div>
  <% elsif @search_results.present? %>
    <header class="search-results__header">
      <p class="search-results__eyebrow">Search Results</p>
      <p class="search-results__summary">
        Showing <strong><%= results_count %> <%= "book".pluralize(results_count) %></strong> for
        <span class="search-results__query">"<%= @query %>"</span>
        in <span class="search-results__scope"><%= GoogleBooksController::SEARCH_SCOPES.fetch(@search_scope, "Title") %></span> search.
      </p>
    </header>

    <div class="search-results__grid">
      <% @search_results.each do |book| %>
        <% footer_content = nil %>
        <% if current_user && book.isbn.present? %>
          <% footer_content = capture { render "result_actions", book: book } %>
        <% end %>

        <article class="search-results__item">
          <%= render "books/book",
            book: book,
            link_target: (book.persisted? ? book_path(book) : nil),
            show_updated: false,
            owner_view: false,
            show_actions: false,
            footer_content: footer_content %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="search-results__empty empty-state">
      <div class="empty-state__icon" aria-hidden="true">
        <i class="fas fa-search"></i>
      </div>
      <p class="empty-state__text">No matching books found</p>
      <p class="empty-state__subtext">Try a different title, author, or ISBN and submit another search right away.</p>
    </div>
  <% end %>
<% end %>
