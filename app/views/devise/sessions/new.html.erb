
<div class="devise-form">
  <h1>Log in</h1>
  <%= render 'book_selections/context' %>

  <div class="devise-form__content">
    <% if flash[:alert].present? %>
      <p class="devise-form__error" role="alert"><%= flash[:alert] %></p>
    <% end %>
    <%= simple_form_for(resource,
                        as: resource_name,
                        url: session_path(resource_name),
                        html: { data: { turbo: false } }) do |f| %>
      <%= f.error_notification %>
      <div class="form-inputs">
        <%= f.label :email %>
        <%= f.input :email,
                    label: false,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.label :password %>
        <%= f.input :password,
                    label: false,
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
      </div>

      <div class="devise-form__checkbox">
        <% if devise_mapping.rememberable? %>
          <%= f.label :remember_me do %>
            <%= f.check_box :remember_me %>
            <span>Remember me</span>
          <% end %>
        <% end %>
      </div>

      <fieldset class="devise-form__actions">
        <%= f.submit "Sign in", class: "btn btn--secondary btn--medium" %>
        <% if session[:book_selection].present? %>
          <%= button_tag 'Cancel', type: 'submit', form: 'book-selection-cancel', class: 'btn btn--light btn--medium' %>
        <% else %>
          <%= link_to "Cancel", root_path, class: "btn btn--light btn--medium" %>
        <% end %>
      </fieldset>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
