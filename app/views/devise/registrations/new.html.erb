<div class="devise-form">
  <h1>Sign up</h1>
  <%= render 'book_selections/context' %>

  <div class="devise-form__content">
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name),
                        html: { data: { turbo: false } }) do |f| %>
      <% if resource.errors.any? %>
        <div class="devise-form__error" role="alert">
          <p>Check these details:</p>
          <ul>
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-inputs">
        <%= f.label :username %>
        <%= f.input :username,
                    label: false,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "username" }%>
        <%= f.label :email %>
        <%= f.input :email,
                    label: false,
                    required: true,
                    input_html: { autocomplete: "email" }%>
        <%= f.label :password %>
        <%= f.input :password,
                    label: false,
                    required: true,
                    input_html: { autocomplete: "new-password", aria: { describedby: 'signup-password-hint' } } %>
        <p id="signup-password-hint" class="hint"><%= @minimum_password_length %> characters minimum</p>
        <%= f.label :password_confirmation %>
        <%= f.input :password_confirmation,
                    label: false,
                    required: true,
                    input_html: { autocomplete: "new-password" } %>
      </div>

      <fieldset class="devise-form__actions">
        <%= f.submit "Sign up", class: "btn btn--secondary btn--medium" %>
        <% if session[:book_selection].present? %>
          <%= button_tag 'Cancel', type: 'submit', form: 'book-selection-cancel', class: 'btn btn--light btn--medium' %>
        <% else %>
          <%= link_to "Cancel", root_path, class: "btn btn--light btn--medium" %>
        <% end %>
      </fieldset>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
